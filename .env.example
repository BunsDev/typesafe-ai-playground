# Server-only: never prefix this variable with NEXT_PUBLIC_.
# Copy this file to .env.local and insert your own TypeSafe API key.
TYPESAFE_API_KEY=

# Optional: small-LLM text helper for the browser agent's TYPE_TEXT operation.
# OpenAI-compatible chat completions; credentials stay server-side. Without it,
# the lab lets Jev pick the field value from spans of the goal instead.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
