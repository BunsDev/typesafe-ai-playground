engine-strict=true

# A flat node_modules, not pnpm's default symlink tree.
#
# next.config.ts traces files into the deployment bundle with explicit globs
# (`./node_modules/z3-solver/build/**/*`). Under the default linker those paths
# are symlinks into .pnpm/, and Vercel refuses the result: "The framework
# produced an invalid deployment package for a Serverless Function. Typically
# this means that the framework produces files in symlinked directories."
#
# The store, the single lockfile and the fast installs are unaffected; what is
# given up is pnpm's strict isolation, which is the lesser loss against a
# deployment that cannot ship.
node-linker=hoisted
